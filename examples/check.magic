REM The counter checks field order: parent fields, then child fields, then new.

class Box
  n = 0
  fn new(start)
    self.n = start
  end
  fn label()
    return "n=" .. self.n
  end
end

class Counter is Box
  extra = 1
  fn new(start)
    super(start)
  end
  fn bump()
    self.n = self.n + 1
    return self.n
  end
end

let box = Counter(2)
print box.bump()
print box.label()

